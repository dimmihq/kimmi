{
  "name": "@kimmi/browser",
  "version": "0.2.0",
  "description": "Browser SDK for kimmi, self-hosted session replay",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./kimmi.js": "./dist/kimmi.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsup && playwright test --config test/e2e/playwright.config.ts",
    "test:stack": "playwright test --config test/stack/playwright.config.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "rrweb": "2.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@rrweb/types": "2.2.2",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2"
  }
}
