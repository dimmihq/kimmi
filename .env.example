# Copy to .env. Compose and `make dev` both read it.

# Signs login cookies. Any random string of 32+ characters: `openssl rand -hex 32`
KIMMI_SECRET=change-me-to-a-long-random-string-of-32-chars

# Where people reach kimmi. Used in the install snippet and in invite links.
KIMMI_PUBLIC_URL=http://localhost:8700

# open: anyone can create an account. closed: invitation only.
KIMMI_SIGNUPS=open

# PostgreSQL (the compose stack starts one with these credentials).
POSTGRES_USER=kimmi
POSTGRES_PASSWORD=kimmi
POSTGRES_DB=kimmi

# S3-compatible storage for recordings (the compose stack starts SeaweedFS).
KIMMI_S3_BUCKET=kimmi
KIMMI_S3_REGION=us-east-1
KIMMI_S3_ACCESS_KEY=kimmi
KIMMI_S3_SECRET_KEY=kimmi-secret
